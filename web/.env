# Build-time settings for every build (Vite reads this file; it holds nothing secret).
# Override one for a build with an environment variable or a git-ignored .env.local.

# Who runs the site, and where people write: named on the Terms and Privacy pages.
# Everything sent to @syncbingo.com forwards to the operator; the separate addresses keep mail sortable.
VITE_OPERATOR_NAME=Nathan Holst
VITE_LEGAL_EMAIL=legal@syncbingo.com
VITE_SUPPORT_EMAIL=support@syncbingo.com
