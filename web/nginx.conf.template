# Serves the SPA and proxies the API, as CloudFront does in AWS (docs/07).

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# A template: at start-up the image fills in ${NGINX_LOCAL_RESOLVERS} (the container's DNS servers), so nginx
# can look `api` up again (below) instead of keeping the address it had when it started. Restarting the API
# container otherwise leaves every request failing with 502.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
  listen 8080;
  # A variable makes nginx resolve the name per request (cached for 10 s), not once at start-up.
  set $api http://api:8080;
  server_name _;
  root /usr/share/nginx/html;

  location /api/ {
    proxy_pass $api;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # SignalR over WebSockets: long-lived, upgraded connections.
  location /hubs/ {
    proxy_pass $api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 1h;
  }

  # Hashed build assets never change, so cache them hard.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # SPA fallback: client-side routes such as /join/abcd-... load index.html.
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
}
