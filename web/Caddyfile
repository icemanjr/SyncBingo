# The live site (Lean profile, ADR 0011): HTTPS with Let's Encrypt certificates, the web app, and the API
# behind it, as nginx does locally and CloudFront in the Full profile (docs/07).
#
# SITE_DOMAIN is the public name (syncbingo.com). Left unset, Caddy serves https://localhost with a
# certificate from its own local authority, for trying the production setup on a laptop.

{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# The API and SignalR (WebSockets, which Caddy proxies without extra settings). Caddy replaces any
	# X-Forwarded-For a client sends with the client's real address; the API trusts it (ForwardedHeaders).
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /hubs/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv

		# Hashed build assets never change, so cache them hard; pages are checked every time.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"

		# ads.txt exists only once AdSense is set up (ADR 0012); until then it's a 404, not the app's page.
		@noAdsTxt {
			path /ads.txt
			not file
		}
		respond @noAdsTxt 404

		# Client-side routes such as /join/... load index.html.
		try_files {path} /index.html
		file_server
	}
}

www.{$SITE_DOMAIN:localhost} {
	redir https://{$SITE_DOMAIN:localhost}{uri} permanent
}
